# Template only. Copy to .env and fill in there. NEVER put real values in this file.

# Supabase — Settings → API Keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com. Separate from your Claude Code subscription.
ANTHROPIC_API_KEY=

# Postgres direct connection — Settings → Database → URI (session pooler). Optional.
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Client-visible (Vite only exposes VITE_* to the browser).
# NEVER add SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

PORT=3001
